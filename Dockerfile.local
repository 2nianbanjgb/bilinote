# 把本地修好的代码固化进镜像（适合分享给别人 / 不想用源码挂载的场景）
#
# 用法：
#   docker build -f Dockerfile.local -t bilinote-fixed:latest .
#   docker run -d --name bilinote -p 3015:80 bilinote-fixed:latest
#
# 说明：只覆盖修复过的几个文件，其余完全沿用官方镜像，构建只需几秒（不需要重新装依赖）。
ARG BASE_IMAGE=ghcr.io/jefferyhcool/bilinote:latest
FROM ${BASE_IMAGE}

# 修复：重试时音频缓存跳过视频下载，导致截图无图可插
COPY backend/app/services/note.py /app/backend/app/services/note.py
# 修复：*Content-[mm:ss]* 替换抛 UnboundLocalError；B 站链接漏 ? 导致跳转失效
COPY backend/app/utils/note_helper.py /app/backend/app/utils/note_helper.py
# 偏好：标题不编号（Markdown 编辑器自动编号）
COPY backend/app/gpt/prompt_builder.py /app/backend/app/gpt/prompt_builder.py
COPY backend/app/validators/video_url_validator.py /app/backend/app/validators/video_url_validator.py
COPY backend/app/downloaders/douyin_downloader.py /app/backend/app/downloaders/douyin_downloader.py
# 修复：网页删除任务时真正清理文件/截图/媒体/向量索引
COPY backend/app/routers/note.py /app/backend/app/routers/note.py
# 新增：按视频查 task_id（删除用）
COPY backend/app/db/video_task_dao.py /app/backend/app/db/video_task_dao.py
# 模型下载源：hf-mirror 的 308 缺 x-linked-size，改成直连 huggingface.co
COPY deploy/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
# 前端重新构建：下载按钮改为打包 zip（md + 同名图片文件夹）
COPY ./frontend-dist /usr/share/nginx/html
# 抖音接口签名由页面 JS 生成，纯 requests 会被 Argus 拦；装无头 Chromium 兜底
# 注意：Debian 12 上不能用 `playwright install --with-deps`（它按 Ubuntu 装包，会失败），
# 这里手动装 Chromium 运行库，再只下载浏览器本体。
RUN apt-get update && apt-get install -y --no-install-recommends \
        libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
        libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
        libgbm1 libasound2 libpango-1.0-0 libcairo2 libatspi2.0-0 \
        libx11-xcb1 libxext6 libxi6 libxtst6 fonts-liberation libvulkan1 \
    && pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple playwright==1.48.0 \
    && PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright python -m playwright install chromium \
    && rm -rf /var/lib/apt/lists/*